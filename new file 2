* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: radial-gradient(circle at top, #151515, #000);
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
  overflow: hidden;
}

h1 {
  margin: 15px;
  color: #00ffff;
  text-shadow: 0 0 10px #00ffff, 0 0 25px #00ffff;
  letter-spacing: 3px;
}

#game {
  position: relative;
  width: 400px;
  height: 600px;
  margin: 0 auto;
}

#hud {
  display: flex;
  justify-content: space-between;
  padding: 8px 12px;
  font-size: 16px;
  font-weight: bold;
}

#lives {
  font-size: 18px;
}

#road {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background:
    repeating-linear-gradient(
        90deg,
        #333 0px,
        #333 125px,
        #ffffff 125px,
        #ffffff 135px,
        #333 135px,
        #333 265px,
        #ffffff 265px,
        #ffffff 275px,
        #333 275px,
        #333 400px
    );
  background-size: 400px 600px;
  border-left: 8px solid #00ffff;
  border-right: 8px solid #00ffff;
  animation: roadMove 0.5s linear infinite;
}

@keyframes roadMove {
  from {
    background-position: 0 0;
  }
  to {
    background-position: 0 100px;
  }
}

/* Player and enemy cars */
.player,
.enemy {
  position: absolute;
  width: 60px;
  height: 100px;
  border-radius: 15px;
}

.player {
  bottom: 30px;
  left: 170px;
  background: linear-gradient(90deg, #ff004c, #ff5c8a, #ff004c);
  box-shadow: 0 0 20px #ff004c;
  transition: box-shadow 0.15s;
}

.player.hit {
  box-shadow: 0 0 30px 10px #ffffff;
}

.enemy {
  background: linear-gradient(90deg, #ffcc00, #fff176, #ffcc00);
  box-shadow: 0 0 20px #ffcc00;
}

/* Coin pickups */
.coin {
  position: absolute;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: radial-gradient(circle, #fff9c4, #ffd700);
  box-shadow: 0 0 15px #ffd700;
}

/* Car windows */
.player::before,
.enemy::before {
  content: "";
  position: absolute;
  width: 38px;
  height: 35px;
  background: #111;
  left: 11px;
  top: 15px;
  border-radius: 8px;
}

/* Wheels */
.player::after,
.enemy::after {
  content: "";
  position: absolute;
  width: 70px;
  height: 15px;
  background:
    linear-gradient(
      90deg,
      #111 0%,
      #111 20%,
      transparent 20%,
      transparent 80%,
      #111 80%,
      #111 100%
    );
  left: -5px;
  top: 70px;
}

#gameOver {
  display: none;
  position: absolute;
  z-index: 20;
  width: 100%;
  top: 200px;
  text-align: center;
  background: rgba(0, 0, 0, 0.85);
  padding: 25px;
  border: 2px solid #ff004c;
  box-shadow: 0 0 30px #ff004c;
}

#gameOver h2 {
  color: #ff004c;
  font-size: 35px;
}

button {
  margin-top: 15px;
  padding: 12px 25px;
  border: none;
  border-radius: 8px;
  background: #00ffff;
  color: black;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  transform: scale(1.1);
  box-shadow: 0 0 20px #00ffff;
}

#controls {
  margin-top: 15px;
  display: flex;
  justify-content: center;
  gap: 40px;
}

#controls button {
  width: 80px;
  height: 60px;
  font-size: 30px;
  border-radius: 15px;
}

@media (max-width: 500px) {
  h1 {
    font-size: 22px;
    margin: 10px;
  }
  #game {
    width: 95vw;
    height: 70vh;
  }
  #controls button {
    width: 90px;
    height: 65px;
    font-size: 32px;
  }
}
