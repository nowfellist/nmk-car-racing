}

/* Player car */
.player,
.enemy {
position: absolute;
width: 60px;
height: 100px;
border-radius: 15px;
}

/* Player */
.player {
bottom: 30px;
left: 170px;
background: linear-gradient(90deg, #ff004c, #ff5c8a, #ff004c);
box-shadow: 0 0 20px #ff004c;
}

/* Enemy */
.enemy {
background: linear-gradient(90deg, #ffcc00, #fff176, #ffcc00);
box-shadow: 0 0 20px #ffcc00;
}

/* Car windows */
.player::before,
.enemy::before {
content: "";
position: absolute;
width: 38px;
height: 35px;
background: #111;
left: 11px;
top: 15px;
border-radius: 8px;
}

/* Wheels */
.player::after,
.enemy::after {
content: "";
position: absolute;
width: 70px;
height: 15px;
background:
linear-gradient(
90deg,
#111 0%,
#111 20%,
transparent 20%,
transparent 80%,
#111 80%,
#111 100%
);
left: -5px;
top: 70px;
}

#score {
position: absolute;
top: 10px;
left: 10px;
z-index: 10;
font-size: 22px;
font-weight: bold;
color: white;
text-shadow: 0 0 10px #00ffff;
}

#gameOver {
display: none;
position: absolute;
z-index: 20;
width: 100%;
top: 200px;
text-align: center;

