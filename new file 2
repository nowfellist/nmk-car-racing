style.css
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  }

body {
background: #080808;
color: white;
font-family: Arial, sans-serif;
text-align: center;
overflow: hidden;
}

h1 {
margin: 15px;
color: #00ffff;
text-shadow: 0 0 10px #00ffff;
}

#game {
position: relative;
width: 400px;
height: 600px;
margin: auto;
}

#road {
position: relative;
width: 100%;
height: 100%;
background: #333;
border-left: 8px solid #00ffff;
border-right: 8px solid #00ffff;
overflow: hidden;
}

/* Player car */
.player {
position: absolute;
width: 60px;
height: 100px;
background: #ff004c;
bottom: 30px;
left: 170px;
border-radius: 12px;
box-shadow: 0 0 20px #ff004c;
}

/* Score */
#score {
position: absolute;
top: 10px;
left: 10px;
z-index: 10;
font-size: 22px;
font-weight: bold;
}

/* Game over screen */
#gameOver {
display: none;
position: absolute;
z-index: 20;
width: 100%;
top: 200px;
text-align: center;
}

button {
padding: 12px 25px;
border: none;
border-radius: 8px;
background: #00ffff;
color: black;
font-size: 18px;
font-weight: bold;
cursor: pointer;
}
